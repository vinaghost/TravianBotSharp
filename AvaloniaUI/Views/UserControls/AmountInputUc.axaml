<v:AmountInputUcBase
    x:Class="AvaloniaUI.Views.UserControls.AmountInputUc"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:AvaloniaUI.Views.UserControls"
    x:Name="root">
    <StackPanel
        Margin="5,0,0,0"
        VerticalAlignment="Bottom"
        Orientation="Horizontal">
        <Image
            Width="18"
            Height="22"
            Source="/Resources/granary.png" />
        <TextBox
            x:Name="Value"
            MinWidth="60"
            Margin="10,0,5,0"
            PlaceholderText="{Binding #root.Text}"
            UseFloatingPlaceholder="True" />
        <Label VerticalAlignment="Bottom" Content="{Binding #root.Unit}" />
    </StackPanel>
</v:AmountInputUcBase>
