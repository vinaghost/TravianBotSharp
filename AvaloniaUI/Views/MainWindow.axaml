<v:MainWindowBase
    x:Class="AvaloniaUI.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:AvaloniaUI.Views"
    xmlns:v_uc="using:AvaloniaUI.Views.UserControls"
    xmlns:vm_uc="using:MainCore.UI.ViewModels.UserControls"
    Title="Travian Bot Sharp"
    Width="1024"
    Height="512"
    FontSize="13"
    FontWeight="Medium"
    Icon="/Assets/favicon.ico"
    WindowState="Maximized">
    <Grid>
        <ContentControl x:Name="MainLayout">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm_uc:MainLayoutViewModel">
                    <v_uc:MainLayoutUc />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

        <v_uc:WaitingOverlayUc x:Name="WaitingOverlay" />
    </Grid>
</v:MainWindowBase>
