<Window
    x:Class="AvaloniaUI.Views.MessageDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Message"
    MinWidth="320"
    MaxWidth="640"
    CanResize="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="16">
        <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="YesButton"
                MinWidth="80"
                Content="Yes" />
            <Button
                x:Name="NoButton"
                MinWidth="80"
                Content="No" />
            <Button
                x:Name="OkButton"
                MinWidth="80"
                Content="OK" />
        </StackPanel>
    </StackPanel>
</Window>
