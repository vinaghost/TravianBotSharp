<Window x:Class="WPFUI.Views.TelegramSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Telegram notifications" Width="760" Height="850" MinWidth="620" MinHeight="620"
    WindowStartupLocation="CenterOwner" Background="#F5F7FA" Closing="OnClosing">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Telegram notifications" FontSize="24" FontWeight="SemiBold" Foreground="#203047" />
            <TextBlock x:Name="AccountText" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsPanel">
                <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="EnabledBox" Content="Enable Telegram notifications for this account" FontWeight="SemiBold" />
                        <TextBlock Text="Create a bot with @BotFather in Telegram, then open your bot and send /start. Paste its token below. For a group, add the bot and send it a command in that group." TextWrapping="Wrap" Margin="0,10,0,12" />
                        <TextBlock Text="Bot token" FontWeight="SemiBold" />
                        <PasswordBox x:Name="TokenBox" Margin="0,4,0,8" />
                        <TextBlock Text="Saved tokens are protected by Windows Credential Manager on this Windows account." FontSize="11" TextWrapping="Wrap" />
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="Find chats" Click="FindChats" />
                            <ComboBox Grid.Column="2" x:Name="ChatsBox" DisplayMemberPath="Display" SelectionChanged="ChatSelected" ToolTip="Select the intended destination explicitly." />
                        </Grid>
                        <TextBlock Text="Chat ID (or enter it manually)" FontWeight="SemiBold" />
                        <TextBox x:Name="ChatIdBox" Margin="0,4,0,8" />
                        <CheckBox x:Name="SilentBox" Content="Send silently (no Telegram notification sound)" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Notify me about" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox x:Name="AttackBox" Content="Incoming attack detected" Margin="0,4" />
                        <CheckBox x:Name="BuildingBox" Content="Completed building upgrades observed" Margin="0,4" />
                        <CheckBox x:Name="QueueBox" Content="Pending build queue dispatched or satisfied" Margin="0,4" />
                        <CheckBox x:Name="StorageBox" Content="Storage nearly full (any resource at 90%)" Margin="0,4" />
                        <CheckBox x:Name="CropBox" Content="Low crop stocks (10% or less of granary capacity)" Margin="0,4" />
                        <CheckBox x:Name="StatusBox" Content="Account online, paused, or offline" Margin="0,4" />
                        <CheckBox x:Name="ErrorsBox" Content="Task failures and logged errors (summary only)" Margin="0,4" />
                        <CheckBox x:Name="AiBox" Content="AI building plan applied" Margin="0,4" />
                        <TextBlock Text="Alerts follow normal game refreshes while the app is running. No background monitoring while closed. Repeated conditions are suppressed; active construction may continue after the pending queue empties." FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Messages include your account name, server and relevant village. Chat discovery reads recent updates sent to your bot. Saving enables only the checked events; Send test sends one message to the entered chat immediately." TextWrapping="Wrap" FontSize="11" Margin="2,0,2,10" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,10" />
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Content="Delivery status" Click="RefreshStatus" Margin="0,0,8,0" />
                <Button x:Name="ForgetButton" Content="Disable / forget token" Click="ForgetToken" Margin="0,0,8,0" />
                <Button x:Name="TestButton" Content="Send test" Click="SendTest" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="Save" Click="SaveSettings" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
