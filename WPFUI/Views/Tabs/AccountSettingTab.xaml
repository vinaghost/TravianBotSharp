<v:AccountSettingTabBase
    x:Class="WPFUI.Views.Tabs.AccountSettingTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:WPFUI.Views.UserControls"
    xmlns:v="clr-namespace:WPFUI.Views.Tabs"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="#FFE5E5E5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SaveButton"
                Grid.Column="0"
                ToolTip="Save">
                <materialDesign:PackIcon
                    Width="{DynamicResource IconSize}"
                    Height="{DynamicResource IconSize}"
                    Kind="ContentSave" />
            </Button>
            <Button
                x:Name="ImportButton"
                Grid.Column="1"
                Width="{DynamicResource ButtonWidth}"
                Style="{DynamicResource MaterialDesignRaisedDarkButton}"
                ToolTip="Import">
                <materialDesign:PackIcon
                    Width="{DynamicResource IconSize}"
                    Height="{DynamicResource IconSize}"
                    Kind="Import" />
            </Button>
            <Button
                x:Name="ExportButton"
                Grid.Column="2"
                Width="{DynamicResource ButtonWidth}"
                Style="{DynamicResource MaterialDesignRaisedDarkButton}"
                ToolTip="Export">
                <materialDesign:PackIcon
                    Width="{DynamicResource IconSize}"
                    Height="{DynamicResource IconSize}"
                    Kind="Export" />
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Activity settings"
                            TextWrapping="Wrap" />
                        <uc:RangeInputUc
                            x:Name="WorkTime"
                            Text="Work time"
                            Unit="minutes" />
                        <uc:RangeInputUc
                            x:Name="SleepTime"
                            Text="Sleep time"
                            Unit="minutes" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Delay settings"
                            TextWrapping="Wrap" />
                        <uc:RangeInputUc
                            x:Name="ClickDelay"
                            Text="Click delay"
                            Unit="milliseconds" />
                        <uc:RangeInputUc
                            x:Name="TaskDelay"
                            Text="Task delay"
                            Unit="milliseconds" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Feature settings"
                            TextWrapping="Wrap" />
                        <CheckBox x:Name="EnableAutoLoadVillage" Content="Enable auto load village's building" />
                        <CheckBox x:Name="EnableAutoStartAdventure" Content="Enable auto start adventure" />
                        <CheckBox x:Name="EnableAutoClaimDailyQuest" Content="Enable auto claim daily quest" />
                        <CheckBox x:Name="EnableAutoSetHeroPoint" Content="Enable auto set hero point (1 power, 3 res)" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Chrome settings"
                            TextWrapping="Wrap" />
                        <CheckBox x:Name="HeadlessChrome" Content="Use headless chrome" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</v:AccountSettingTabBase>