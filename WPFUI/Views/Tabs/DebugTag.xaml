<v:DebugTagBase
    x:Class="WPFUI.Views.Tabs.DebugTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFUI.Views.Tabs"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:WPFUI.Views.Tabs"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="#FFE5E5E5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="ReportButton"
                Grid.Row="0"
                Grid.Column="0"
                Margin="10"
                Content="Buy a Coffee for Vinaghost" />
            <Button
                x:Name="LogButton"
                Grid.Row="0"
                Grid.Column="1"
                Margin="10"
                Content="Open log folder" />

            <Label
                x:Name="TaskTableLabel"
                Grid.Row="1"
                Grid.Column="0"
                HorizontalContentAlignment="Center"
                Content="Task table" />
            <Label
                x:Name="LogTableLabel"
                Grid.Row="1"
                Grid.Column="1"
                HorizontalContentAlignment="Center"
                Content="Log messages" />
            <Border
                Grid.Row="2"
                Grid.Column="0"
                Style="{DynamicResource Box}">
                <ListView x:Name="TaskView">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn
                                Width="Auto"
                                DisplayMemberBinding="{Binding Task}"
                                Header="Task" />
                            <GridViewColumn
                                Width="Auto"
                                DisplayMemberBinding="{Binding ExecuteAt}"
                                Header="Execute at" />
                            <GridViewColumn
                                Width="Auto"
                                DisplayMemberBinding="{Binding Stage}"
                                Header="Stage" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <Border
                Grid.Row="2"
                Grid.Column="1"
                Style="{DynamicResource Box}">
                <TextBox
                    x:Name="LogView"
                    VerticalContentAlignment="Top"
                    IsReadOnly="True" />
            </Border>
        </Grid>
        <Button
            x:Name="BringToFrontButton"
            Grid.Row="1"
            Margin="10"
            Content="Bring browser to front" />
    </Grid>
</v:DebugTagBase>