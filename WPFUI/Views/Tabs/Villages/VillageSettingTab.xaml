<v:VillageSettingTabBase
    x:Class="WPFUI.Views.Tabs.Villages.VillageSettingTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:WPFUI.Views.UserControls"
    xmlns:v="clr-namespace:WPFUI.Views.Tabs.Villages"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="#FFE5E5E5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SaveButton"
                Grid.Column="0"
                ToolTip="Save">
                <materialDesign:PackIcon
                    Width="{DynamicResource IconSize}"
                    Height="{DynamicResource IconSize}"
                    Kind="ContentSave" />
            </Button>
            <Button
                x:Name="ImportButton"
                Grid.Column="1"
                Width="{DynamicResource ButtonWidth}"
                Style="{DynamicResource MaterialDesignRaisedDarkButton}"
                ToolTip="Import">
                <materialDesign:PackIcon
                    Width="{DynamicResource IconSize}"
                    Height="{DynamicResource IconSize}"
                    Kind="Import" />
            </Button>
            <Button
                x:Name="ExportButton"
                Grid.Column="2"
                Width="{DynamicResource ButtonWidth}"
                Style="{DynamicResource MaterialDesignRaisedDarkButton}"
                ToolTip="Export">
                <materialDesign:PackIcon
                    Width="{DynamicResource IconSize}"
                    Height="{DynamicResource IconSize}"
                    Kind="Export" />
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Upgrade settings"
                            TextWrapping="Wrap" />
                        <CheckBox x:Name="UseHeroResForBuilding" Content="Use hero resources when lack of resources" />
                        <CheckBox x:Name="UseRomanQueueLogic" Content="Use Roman queue logic" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="CompleteImmediately" Content="Use complete immediately button if queue time longer than " />
                            <TextBox x:Name="CompleteImmediatelyTime" Width="25" />
                            <Label Content=" mins" />
                        </StackPanel>

                        <CheckBox x:Name="UseSpecialUpgrade" Content="Use special upgrade method (the right upgrade button)" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Auto refresh"
                            TextWrapping="Wrap" />
                        <CheckBox x:Name="AutoRefreshEnable" Content="Enable auto refresh" />
                        <uc:RangeInputUc
                            x:Name="AutoRefreshTime"
                            Text="Refresh every"
                            Unit="minutes" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="NPC Crop exchange settings"
                            TextWrapping="Wrap" />
                        <CheckBox x:Name="AutoNPCEnable" Content="Enable NPC Crop exchange" />
                        <CheckBox x:Name="AutoNPCOverflow" Content="Despite warehouse overflow" />
                        <uc:AmountInputUc
                            x:Name="AutoNPCGranaryPercent"
                            Text="Granary"
                            Unit="%" />
                        <uc:ResourceInputUc x:Name="AutoNPCRatio" Text="Ratio" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Feature settings"
                            TextWrapping="Wrap" />
                        <CheckBox x:Name="AutoClaimQuestEnable" Content="Enable auto claim village's quest" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Tribe (this should be updated when you load building list)"
                            TextWrapping="Wrap" />
                        <uc:TribeSelectorUc x:Name="Tribes" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Box}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Troop training settings"
                            TextWrapping="Wrap" />
                        <CheckBox x:Name="TrainTroopEnable" Content="Enable train troop" />
                        <uc:RangeInputUc
                            x:Name="TrainTroopRepeatTime"
                            Text="Next train troop execute after"
                            Unit="mins" />
                        <CheckBox x:Name="TrainWhenLowResource" Content="Train maximum number if low on resource" />
                        <StackPanel Orientation="Horizontal">
                            <uc:TroopSelectorUc x:Name="BarrackTroop" Text="Train in barrack" />
                            <uc:RangeInputUc
                                x:Name="BarrackAmount"
                                Margin="10,0,0,0"
                                Text="for"
                                Unit="units" />
                            <uc:TroopSelectorUc
                                x:Name="GreatBarrackTroop"
                                Margin="10,0,0,0"
                                Text="Train in greatbarrack" />
                            <uc:RangeInputUc
                                x:Name="GreatBarrackAmount"
                                Margin="10,0,0,0"
                                Text="for"
                                Unit="units" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <uc:TroopSelectorUc x:Name="StableTroop" Text="Train in stable" />
                            <uc:RangeInputUc
                                x:Name="StableAmount"
                                Margin="10,0,0,0"
                                Text="for"
                                Unit="units" />
                            <uc:TroopSelectorUc
                                x:Name="GreatStableTroop"
                                Margin="10,0,0,0"
                                Text="Train in greatstable" />
                            <uc:RangeInputUc
                                x:Name="GreatStableAmount"
                                Margin="10,0,0,0"
                                Text="for"
                                Unit="units" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <uc:TroopSelectorUc x:Name="WorkshopTroop" Text="Train in workshop" />
                            <uc:RangeInputUc
                                x:Name="WorkshopAmount"
                                Margin="10,0,0,0"
                                Text="for"
                                Unit="units" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</v:VillageSettingTabBase>